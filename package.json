{
  "name": "livenotes",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @livenotes/web",
    "build": "npm run build -w @livenotes/web",
    "preview": "npm run preview -w @livenotes/web",
    "test": "npm run test -w @livenotes/web",
    "test:coverage": "npm run test:coverage -w @livenotes/web",
    "test:e2e": "npm run test:e2e -w @livenotes/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:e2e:offline": "npm run test:e2e:offline -w @livenotes/web"
  }
}
